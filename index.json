const {
  Client,
  GatewayIntentBits,
  REST,
  Routes,
  SlashCommandBuilder
} = require('discord.js');

const client = new Client({
  intents: [GatewayIntentBits.Guilds]
});

const TOKEN = process.env.TOKEN;

const GUILD_ID = '1548711365768781854';
const OWNER_ROLE_ID = '1549055192903852142';

const commands = [
  new SlashCommandBuilder()
    .setName('testowner')
    .setDescription('Teste si tu as le rôle Owner')
    .toJSON()
];

const rest = new REST({ version: '10' }).setToken(TOKEN);

client.once('ready', async () => {
  console.log(`✅ Connecté en tant que ${client.user.tag}`);

  try {
    console.log('🔄 Enregistrement de /testowner...');

    await rest.put(
      Routes.applicationGuildCommands(
        client.user.id,
        GUILD_ID
      ),
      {
        body: commands
      }
    );

    console.log('✅ /testowner enregistré !');

  } catch (error) {
    console.error('❌ Erreur :', error);
  }
});

client.on('interactionCreate', async interaction => {
  if (!interaction.isChatInputCommand()) return;

  if (interaction.commandName === 'testowner') {

    if (!interaction.member.roles.cache.has(OWNER_ROLE_ID)) {
      return interaction.reply({
        content: '❌ Tu n’as pas le rôle Owner.',
        ephemeral: true
      });
    }

    await interaction.reply({
      content: '✅ Tu es Owner ! La protection fonctionne.',
      ephemeral: true
    });
  }
});

client.login(TOKEN);
